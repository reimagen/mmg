# Copy to web/.env.local (Next.js only reads env from the web/ app)

# --- Token pools (Luis) ---
# Primary: OpenAI GPT Live
OPENAI_API_KEY=

# Fallback text pool if GPT Live quota dies (OpenAI-compatible chat, not Live).
# OpenRouter does not have gpt-live-1. Nice-to-have; failover is not wired.
OPENROUTER_API_KEY=

# Third pool (OpenAI-compatible). Same caveat: no GPT Live.
OXEN_API_KEY=
OXEN_BASE_URL=https://hub.oxen.ai/api/ai

# --- Enrichment loop (async, killable) ---
# Live search / profile validation (UUID or exa_… from dashboard.exa.ai/api-keys)
# Next.js only loads this from web/.env.local — copy this file there.
EXA_API_KEY=

# Jake's FastAPI sidecar
MEMORY_API_URL=http://127.0.0.1:7777

# People + company enrichment (Hunter, PDL, Crunchbase, etc.)
# https://treg.to/llms.txt
TREG_TOKEN=

# --- Hermes / hall slow plane (Lisa) ---
# Default off: local Exa queue. Flip to 1 when hall :8768 + hermes serve are up.
# Bearer WS needs `cd web && npm i ws`. Docs: docs/HERMES.md
HERMES_ENABLED=0
HALL_WS_URL=ws://127.0.0.1:8768/hall/ws
HALL_TOKEN=

# --- MentraOS glasses miniapp ---
MENTRA_PACKAGE_NAME=glass.mmg.copilot
NEXT_PUBLIC_MMG_API_URL=http://localhost:3000
